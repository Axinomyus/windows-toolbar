#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_MAINICON ICON "PowerToolbar.ico"
IDI_TRAYICON ICON "PowerToolbar-tray.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Axinomyus"
            VALUE "FileDescription", "PowerToolbar - Window controls, within reach"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "PowerToolbar"
            VALUE "LegalCopyright", "Copyright (c) Axinomyus. MIT License."
            VALUE "OriginalFilename", "PowerToolbar.exe"
            VALUE "ProductName", "PowerToolbar"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
